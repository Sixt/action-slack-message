{
  "name": "action-slack-message-root",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub Action to post messages to Slack using plain text, markdown or Slack's block syntax.",
  "exports": {
    "./core": {
      "types": "./packages/core/dist/index.d.ts",
      "default": "./packages/core/dist/index.js"
    }
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint",
    "format": "prettier --write {packages/*/src,packages/*/\\_\\_tests\\_\\_}/**/*.ts",
    "format-check": "prettier --check {packages/*/src,packages/*/\\_\\_tests\\_\\_}/**/*.ts"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Slack"
  ],
  "author": "Florian Fittschen",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jest": "^29.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "nock": "^14.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
