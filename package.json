{
  "name": "action-slack-message-root",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub Action to post messages to Slack using plain text, markdown or Slack's block syntax.",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint {packages/*/src,packages/*/\\_\\_tests\\_\\_}/**/*.ts --fix",
    "format": "prettier --write {packages/*/src,packages/*/\\_\\_tests\\_\\_}/**/*.ts",
    "format-check": "prettier --check {packages/*/src,packages/*/\\_\\_tests\\_\\_}/**/*.ts"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Slack"
  ],
  "author": "Florian Fittschen",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^4.11.1",
    "@typescript-eslint/parser": "^4.11.1",
    "@vercel/ncc": "^0.38.0",
    "eslint-config-prettier": "^7.1.0",
    "eslint-plugin-jest": "^24.1.3",
    "eslint-plugin-prettier": "^3.3.0",
    "jest": "^29.7.0",
    "js-yaml": "^3.14.1",
    "nock": "^13.0.5",
    "prettier": "^2.2.1",
    "ts-jest": "^29.1.0",
    "typescript": "^4.1.3"
  }
}
